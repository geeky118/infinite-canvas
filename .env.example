# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 腾讯云 COS，用于把登录用户生成/上传的画布图片保存为跨设备可访问的 CDN 地址。
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=
# TENCENT_COS_CDN_DOMAIN=https://cdn.example.com

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_DOC_URL=https://docs.canvas.best

# 远程提示词定时同步默认关闭；后台提示词管理中的手动同步不受影响。
PROMPT_SYNC_SCHEDULER_ENABLED=false
# 可选：构建前端时注入默认本地模型渠道，JSON 数组格式。API Key 会进入浏览器前端产物，只适合个人部署。
# NEXT_PUBLIC_DEFAULT_LOCAL_CHANNELS=[{"id":"grok","name":"Grok","baseUrl":"https://grok2api.example.com","apiKey":"sk-xxx","models":["grok-imagine-1.0-fast"],"imageModels":["grok-imagine-1.0-fast"],"videoModels":[],"textModels":[],"audioModels":[]}]

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# SMTP Email Configuration (邮件服务配置)
# 使用网易163邮箱，163/QQ/企业邮箱通用；端口 465 走隐式 TLS，587 走 STARTTLS。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
# 发件邮箱地址（同时作为 SMTP 登录账号）
SMTP_USER=zhonggangedu@163.com
# SMTP 授权码，不是邮箱登录密码；不同邮箱在邮箱设置中生成。
SMTP_PASS=NYavtJtFGhELremW
# 邮件显示的发件人名称
SMTP_FROM_NAME=无限画布
# 验证码有效期（秒），默认 600 = 10 分钟
# EMAIL_CODE_TTL_SECONDS=600
# 同一邮箱重新发送冷却（秒），默认 60
# EMAIL_CODE_COOLDOWN_SECONDS=60
# 同一邮箱每小时内最多发送次数，默认 5
# EMAIL_CODE_MAX_PER_HOUR=5
# 验证码位数（数字），默认 6
# EMAIL_CODE_LENGTH=6
# 仅允许此域名注册，默认 qq.com。修改后需重启服务。
# REGISTER_EMAIL_DOMAIN=qq.com
