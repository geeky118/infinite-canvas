ARG BASE_IMAGE=infinite-canvas:multi-channel

# Rebuild only the Next.js frontend and reuse the existing runtime image.
FROM oven/bun:1.3.13 AS web-build

WORKDIR /app/web
ARG NEXT_PUBLIC_DEFAULT_LOCAL_CHANNELS=
ENV NEXT_PUBLIC_DEFAULT_LOCAL_CHANNELS=$NEXT_PUBLIC_DEFAULT_LOCAL_CHANNELS
COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --cache-dir=/root/.bun/install/cache
COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY web ./
RUN bun run build

FROM ${BASE_IMAGE}

COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY --from=web-build /app/web/public /app/web/public
COPY --from=web-build /app/web/.next/standalone /app/web
COPY --from=web-build /app/web/.next/static /app/web/.next/static
